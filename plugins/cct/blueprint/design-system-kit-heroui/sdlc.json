{
  "_comment": "Read by the sdlc-run skill and the hooks in .claude/hooks/. Adopted in milestone 1 of online-release-1 (plan in pokbytes/heydiff-web). Tracker: Beads (bd).",
  "linear": {
    "team": "",
    "project": ""
  },
  "defaultBranch": "main",
  "changesDir": "changes",
  "designsDir": "docs/designs",
  "docs": "docs/sdlc.md",
  "verify": "npm run format && npm run lint && npm run typecheck && npm test",
  "verifyDirty": ["*.ts", "*.tsx", "*.js", "*.mjs", "*.vue", "*.json"],
  "lintOnEdit": {
    "*.ts *.tsx *.js *.mjs *.css *.json": "npx biome format --write --vcs-enabled=false {file}"
  },
  "blocked": [
    {
      "match": "(^|[[:space:];&|(])(pnpm|yarn)([[:space:]]+[^[:space:];&|]+)*[[:space:]]+(add|remove)([[:space:]]|$)|(^|[[:space:];&|(])npm([[:space:]]+[^[:space:];&|]+)*[[:space:]]+(i|install|uninstall)[[:space:]]+[^-[:space:]]",
      "message": "dependency changes are Ask-tier: a human adds the package in a branch and commits package.json + the lockfile; the PR gets the ask label. Say which package and why, then stop.",
      "samples": [
        "pnpm add x",
        "yarn add y",
        "npm install left-pad",
        "cd a && pnpm remove x",
        "pnpm --filter web add x",
        "npm --prefix ./app install left-pad"
      ]
    }
  ],
  "toolsCommand": "npm run sdlc:tools",
  "tests": "vitest",
  "codeowners": [],
  "claude": false,
  "claudeAllow": ["Bash(npm *)", "Bash(git:*)", "Bash(gh pr:*)"],
  "showChannel": "",
  "keep": [],
  "tiers": false,
  "kitTemplates": "8165782d8151",
  "tracker": {
    "kind": "beads",
    "initiative": "",
    "project": ""
  },
  "product": "HeyDiff",
  "planGate": "owner",
  "feedback": [],
  "milestones": {
    "branchPrefix": "milestone/",
    "rebaseOnDefault": true
  },
  "projects": {
    "branchPrefix": "project/",
    "rebaseOnDefault": true
  },
  "hotfix": true,
  "delivery": "one-go",
  "goal": {
    "runTurns": 500,
    "featureTurns": 40,
    "milestoneTurns": 30
  },
  "languages": ["en"],
  "responsiveTier": "none",
  "ux": "off",
  "checks": {
    "feature": ["npm run format:check", "npm run lint", "npm run typecheck", "npm test"],
    "milestone": ["npm run format:check", "npm run lint", "npm run typecheck", "npm test", "npm run smoke:background"]
  },
  "verifyStop": "npm run format && npm run lint && npm run typecheck",
  "ciPaths": {
    "_comment": "Shell globs (* also crosses /), the shape of the kit's sdlc-run 3.3.1. A file in `docs`, or in neither `code` nor `config`, runs NOTHING. A file in `all` runs lint and unit. Any other code or config file runs the steps whose include it matches and whose exclude it does not; one no step lists (package.json, tsconfig, biome.json, vitest.config.ts, .nvmrc, .npmrc) runs lint and unit. Steps: lint = format, lint, typecheck; unit = vitest; publish = the semver release to GitHub Packages on a merge into main or project/* (.github/workflows/publish.yml), only for what a package ships (src, css, lint, package.json); the lockfile, the workflows, tests and docs never publish. This repo has no build, E2E or deploy step. Safety net: a push to main, and a PR into main or project/* (or from milestone/*) that touches any code or config, run lint and unit. Edit the lists here, not in scripts/ci-scope.sh.",
    "docs": [
      "changes/*",
      "docs/*",
      "plans/*",
      ".claude/*",
      ".beads/*",
      "design-explorations/*",
      "README.md",
      "AGENTS.md",
      "CLAUDE.md",
      "REVIEW.md",
      "*.txt"
    ],
    "all": [".github/workflows/*", "sdlc.json", "package-lock.json", ".releaserc.json"],
    "code": ["packages/*", "test/*", "tests/*", "scripts/*", "*.ts", "*.tsx", "*.js", "*.mjs", "*.cjs"],
    "config": ["package.json", "tsconfig*.json", "biome.json", "vitest.config.*", ".nvmrc", ".npmrc"],
    "specs": [],
    "lint": {
      "include": ["packages/*", "test/*", "tests/*"],
      "exclude": ["*.md"]
    },
    "unit": {
      "include": ["packages/*", "test/*", "tests/*", "scripts/*"],
      "exclude": ["*.md"]
    },
    "publish": {
      "include": ["packages/*/src/*", "packages/*/css/*", "packages/*/lint/*", "packages/*/package.json"],
      "exclude": ["*.test.*"]
    },
    "build": {
      "include": ["src/*", "app/*", "public/*", "Dockerfile", "next.config.*"],
      "exclude": ["e2e/*", "test/*", "*.test.*", "*.css", "*.scss"]
    },
    "e2e": {
      "include": ["src/*", "app/*", "public/*", "e2e/*", "next.config.*", "playwright.config.*", "*.sql", "drizzle/*"],
      "exclude": ["test/*", "*.test.*"]
    },
    "deploy": {
      "include": ["src/*", "app/*", "public/*", "Dockerfile", "deploy/*", "next.config.*", "*.sql", "drizzle/*"],
      "exclude": ["e2e/*", "test/*", "*.test.*"]
    }
  },
  "ciCommands": {
    "install": "npm ci --ignore-scripts && npm rebuild canvas",
    "lint": "npm run format:check && npm run lint && npm run typecheck",
    "unit": "npm test",
    "build": "true",
    "e2e": "true",
    "e2eTouched": "true"
  },
  "sdlcVersion": "3.4.1"
}
