#!/usr/bin/env bash
# Usage: ph help                  - every subcommand
#        ph <area> <verb> [args]  - flags, experiments, dashboards, insights, trend, funnel, retention, events, query,
#                                   recordings, playlists, persons, cohorts, annotations, surveys, errors, properties, actions
#        ph METHOD /path [json|@file.json] - any PostHog REST call; "{project}" in the path becomes the project id
# Purpose: the PostHog API with the user's personal API key, without the key reaching stdout, stderr or the process list.
# Output: one compact JSON object per line (no output = no rows); --table or --csv for lists. Keys shaped like ph?_... are redacted.
# Writes: every change prints the request and an approval code, and stops; --yes CODE sends exactly that request.
set -euo pipefail

die() { echo "posthog-manage: $1" >&2; exit "${2:-1}"; }
note() { echo "posthog-manage: $1" >&2; }

usage() {
  cat <<'EOF'
Setup       ph check | ph whoami | ph projects | ph use <project-id>
Flags       ph flags list [--active] [--search S] [--limit N] | ph flags get <key|id> | ph flags evaluate <flag> <distinct-id>
            ph flags create <key> [--name N] [--rollout PCT] [--prop k=v|k~v]... [--variants a:50,b:50] [--active]
            ph flags rollout <flag> <PCT> [--condition N] | ph flags enable|disable|delete <flag>
Experiments ph experiments list [--status S] [--limit N] | ph experiments get <id> | ph experiments results <id>
            ph experiments create <name> --flag <key> [--variants control:50,test:50] [--event E | --funnel e1,e2]
            ph experiments create ...  [--description D] [--allow-unknown-events]   (an existing flag is reused as it is)
            ph experiments launch <id> | ph experiments stop <id> [--conclusion won|lost|inconclusive|stopped_early|invalid] [--comment C]
            ph experiments archive <id> [--disable-flag] | ph experiments delete <id>
Dashboards  ph dashboards list | get <id> | url <id> | create <name> [--description D] | add <dashboard-id> <insight-id> | delete <id>
Insights    ph insights list [--search S] | ph insights get <id|short-id> | ph insights url <id|short-id> | ph insights delete <id>
            ph insights create trend <event> | funnel <e1> <e2>... | hogql 'SQL'   --name N [--dashboard ID] [report options]
Reports     ph trend <event> [--days N | --from DATE --to DATE] [--interval hour|day|week|month] [--breakdown PROP] [--math total|dau|weekly_active|monthly_active]
            ph funnel <e1> <e2>... [--days N | --from DATE --to DATE] [--window DAYS] [--breakdown PROP]
            ph retention <event> [--return-event E] [--period Day|Week|Month] [--intervals N]
            ph events top [--days N] [--limit N]
            ph query 'HogQL'
Recordings  ph recordings list [--days N] [--person ID|EMAIL] [--min-duration SEC] [--errors] [--url TEXT] [--limit N]
            ph recordings get <session-id> | ph recordings console <session-id> [--level error|warn|info|log] | ph recordings events <session-id>
            ph recordings export <session-id> <file>     (personal data: a new private file outside any git repo)
Playlists   ph playlists list | ph playlists add <playlist-short-id> <session-id>
People      ph persons find <distinct-id|email> | ph persons events <distinct-id|email> [--days N] [--limit N]
Cohorts     ph cohorts list | ph cohorts create-static <name> <distinct-id>... | ph cohorts create-static <name> @ids.txt
Other       ph annotations list | create <text> [--date ISO] | delete <id>
            ph surveys list | get <id> | results <id> [--days N]
            ph errors list [--status active|resolved|archived] [--limit N]
            ph events list [--search S] | describe <name> | verify <name>
            ph properties list [--event NAME] [--search S]
            ph actions list
Raw         ph METHOD /path [json|@file.json]        (anything but GET and POST .../query/ is a write)
Global      --yes CODE sends a write the dry run showed (CODE is its approval code); --table or --csv for lists;
            --personal shows emails, distinct ids, full URLs and console text; -- ends options; ph <area> --help
EOF
}

# Help needs no credentials: answer it before reading any.
for a in "$@"; do
  [[ "$a" == -- ]] && break
  if [[ "$a" =~ ^(-h|--help|help)$ ]]; then
    if [[ "${1:-help}" =~ ^(-h|--help|help)$ ]]; then usage; else usage | grep -E "(^| )ph $1( |$)|^Global" || usage; fi
    exit 0
  fi
done
[[ $# -gt 0 ]] || { usage; exit 0; }
command -v jq >/dev/null 2>&1 || die "needs jq (brew install jq, apt install jq)"

YES="" APPROVE="" FMT=json PERSONAL="" ARGS=() lit=""
while (($#)); do
  if [[ -n "$lit" ]]; then ARGS+=("$1"); shift; continue; fi
  case $1 in
    --yes) [[ $# -ge 2 && "$2" =~ ^[0-9a-f]{12}$ ]] || die "--yes needs the 12-character approval code the dry run printed" 2
           YES=1 APPROVE=$2; shift 2 ;;
    --yes=*) APPROVE=${1#--yes=}; [[ "$APPROVE" =~ ^[0-9a-f]{12}$ ]] || die "--yes needs the approval code the dry run printed" 2; YES=1; shift ;;
    --table) FMT=table; shift ;;
    --csv) FMT=csv; shift ;;
    --personal) PERSONAL=1; shift ;;
    --) lit=1; ARGS+=("--"); shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# Values come from the environment; if unset, from the user's interactive zsh profile (its banner goes to /dev/null, only the value comes back on fd 3).
zshvar() { command -v zsh >/dev/null 2>&1 && zsh -ic "print -rn -- \"\$$1\" >&3" 3>&1 >/dev/null 2>&1 || true; }

key="${POSTHOG_API_KEY:-$(zshvar POSTHOG_API_KEY)}"
host="${POSTHOG_HOST:-$(zshvar POSTHOG_HOST)}"
project="${POSTHOG_PROJECT_ID:-$(zshvar POSTHOG_PROJECT_ID)}"
# The key stays in this shell variable: unset the exported copy so no child (jq, git, curl) inherits it.
unset POSTHOG_API_KEY

if [[ "${1:-}" == check ]]; then
  for pair in "POSTHOG_API_KEY=$key" "POSTHOG_HOST=$host" "POSTHOG_PROJECT_ID=$project"; do
    [[ -n "${pair#*=}" ]] && echo "${pair%%=*}: set" || echo "${pair%%=*}: missing"
  done
  exit 0
fi

[[ -n "$key" ]] || die "export POSTHOG_API_KEY in your shell profile (see the skill's first run)"

# ── The one place that talks to PostHog ───────────────────────────────────────
redact() { sed -E 's/ph[a-z]_[A-Za-z0-9_-]{8,}/ph_[redacted]/g'; }
if command -v shasum >/dev/null 2>&1; then sha() { shasum -a 256 | cut -c1-12; }; else sha() { sha256sum | cut -c1-12; }; fi

curl_args() { # METHOD URL [BODY] -> CURL array. -q first: no ~/.curlrc can add verbose output, a proxy or weaker TLS.
  CURL=(-q -sS -g --proto =https --proto-redir =https --max-redirs 0 --connect-timeout 10 --max-time 120
        -X "$1" "$2" -H "Content-Type: application/json")
  if [[ -n "${3:-}" ]]; then CURL+=(--data-raw "$3"); fi
}

host_detected=""
detect_host() {
  local h code
  for h in https://eu.posthog.com https://us.posthog.com; do
    curl_args GET "$h/api/users/@me/"
    code=$(curl "${CURL[@]}" -o /dev/null -w '%{http_code}' -H @- <<<"Authorization: Bearer $key" 2>/dev/null || true)
    if [[ "$code" == 200 ]]; then
      host=$h host_detected=1
      note "the key works on $h; add  export POSTHOG_HOST=$h  to your profile to skip this check"
      return
    fi
  done
  die "the key works on neither https://eu.posthog.com nor https://us.posthog.com; set POSTHOG_HOST to your self-hosted URL"
}

if [[ -z "$host" ]]; then detect_host; fi
host="${host%/}"
[[ "$host" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || die "POSTHOG_HOST must be a bare https origin, e.g. https://eu.posthog.com"
hostname=${host#https://}; hostname=${hostname%%:*}
[[ ! "$hostname" =~ (^|\.)i\.posthog\.com$ ]] || die "POSTHOG_HOST is an ingestion host; the API lives at https://eu.posthog.com or https://us.posthog.com"

# raw METHOD PATH [BODY]: one call, response on stdout with keys redacted; on an HTTP error the body goes to stderr and it exits.
# A read (GET, or POST to /query/) that meets 429 or a 5xx gateway error is retried once after 2 seconds.
raw() {
  local method=$1 path=$2 body=${3:-} out code tries=0
  case "$method" in GET|POST|PATCH|PUT|DELETE) ;; *) die "method must be GET, POST, PATCH, PUT or DELETE" 2 ;; esac
  # The path is glued to the host: one not starting with a single "/" ("@evil.com/x", ".evil.com/x", "//evil.com") would send the key elsewhere.
  [[ "$path" == /* && "$path" != //* ]] || die "path must be an absolute API path starting with one /, e.g. /api/projects/{project}/..." 2
  if [[ "$path" == *"{project}"* ]]; then
    [[ -n "$project" ]] || die "no project selected: export POSTHOG_PROJECT_ID (ph projects lists them)"
    path=${path//\{project\}/$project}
  fi
  curl_args "$method" "$host$path" "$body"
  while :; do
    # The header comes from a here-string, so the key is never on the command line; curl's own errors pass through redact.
    out=$(curl "${CURL[@]}" -w '\n%{http_code}' -H @- <<<"Authorization: Bearer $key" 2> >(redact >&2)) || die "$method ${path%%\?*}: no connection to $host"
    code=${out##*$'\n'}; out=${out%$'\n'*}
    if [[ "$code" =~ ^(429|502|503|504)$ && $tries == 0 && ( "$method" == GET || "$path" == */query/* ) ]]; then
      tries=1; note "$method ${path%%\?*}: HTTP $code, retrying once"; sleep 2; continue
    fi
    break
  done
  out=$(printf '%s' "$out" | redact)
  if [[ ! "$code" =~ ^2 ]]; then
    printf '%s\n' "$out" | head -c 2000 >&2; echo >&2
    case $code in
      401|403) die "$method ${path%%\?*}: HTTP $code, the key is wrong or lacks the scope this call needs" ;;
      409) die "$method ${path%%\?*}: HTTP 409, someone changed it since it was read; read it again and re-decide" ;;
      429) die "$method ${path%%\?*}: HTTP 429, rate limited; wait a minute and batch the calls" ;;
      *) die "$method ${path%%\?*}: HTTP $code" ;;
    esac
  fi
  printf '%s\n' "$out"
}

# write METHOD PATH BODY WHAT [STATE]: a change. Without --yes it shows the request and an approval code, then stops.
# The code hashes the request and the current state of the object it changes, so --yes CODE sends only what was shown.
WRITE_SUMMARY='if type == "object" then {id, key, short_id, name, status, active, deleted, version} | with_entries(select(.value != null)) else . end'
write() {
  local method=$1 path=$2 body=$3 what=$4 state=${5:-} resolved code
  resolved=${path//\{project\}/$project}
  code=$(printf '%s\n%s\n%s\n%s\n%s' "$method" "$resolved" "$body" "$what" "$state" | sha)
  if [[ -z "$YES" ]]; then
    echo "DRY RUN, nothing sent. $what"
    echo "Request: $method $resolved"
    if [[ -n "$body" ]]; then echo "Body: $body" | redact; fi
    echo "Approval code: $code. To send exactly this: the same command with --yes $code"
    exit 0
  fi
  if [[ "$APPROVE" != "$code" ]]; then
    echo "Now: $what" >&2
    die "approval code $APPROVE does not match this request ($code): the request or the object changed since the dry run. Review the dry run again." 3
  fi
  raw "$method" "$path" "$body" | jq -c "$WRITE_SUMMARY"
}

# Personal data stays out of default output: emails become [email], URLs lose their query string and fragment.
if [[ -n "$PERSONAL" ]]; then CLEAN='def clean: .;'
else CLEAN='def clean: if type == "string" then gsub("[^\\s@<>\"]+@[^\\s@<>\"]+\\.[A-Za-z]{2,}"; "[email]") | gsub("(?<u>https?://[^\\s?#\"]*)[?#][^\\s\"]*"; "\(.u)") else . end;'
fi
pid() { if [[ -n "$PERSONAL" ]]; then echo '.'; else echo 'null'; fi; } # jq filter: keep a distinct id only with --personal

list_get() { local r; r=$(raw GET "$1"); more "$r"; printf '%s\n' "$r"; } # one page of a list, with the partial note

# A list response: note when PostHog has more than one page, so a partial list never looks complete.
more() { # RESPONSE-JSON
  if jq -e '(.next // null) != null or .has_next == true or .has_more == true' >/dev/null <<<"$1"; then
    note "partial: $(jq '(.results // []) | length' <<<"$1") shown and more exist; raise --limit or narrow the search"
  fi
}

q() { jq -rn --arg v "$1" '$v|@uri'; }

# Lists: a JSON array on stdin -> one object per line, or --table / --csv with a header row.
rows() {
  case $FMT in
    json) jq -c '.[]' ;;
    table) jq -r 'if length == 0 then "(no rows)" else (.[0]|keys_unsorted) as $k | ($k|@tsv),
             (.[] | [.[$k[]] | if . == null or . == "" then "-" elif type == "string" then . else tojson end] | @tsv) end' | column -t -s $'\t' ;;
    csv) jq -r 'if length == 0 then empty else (.[0]|keys_unsorted) as $k | ($k|@csv),
             (.[] | [.[$k[]] | if type == "string" or type == "number" then . elif . == null then "" else tojson end] | @csv) end' ;;
  esac
}

# parse "bool-options" "value-options" args...: sets o_<name> (a repeated value joins with newlines) and POS.
parse() {
  local bools=" $1 " vals=" $2 " n v cur; shift 2
  POS=()
  for n in $bools $vals; do unset "o_${n//-/_}"; done
  while (($#)); do
    case $1 in
      --) shift; POS+=("$@"); break ;;
      --*)
        n=${1#--}
        if [[ "$bools" == *" $n "* ]]; then printf -v "o_${n//-/_}" 1; shift
        elif [[ "$vals" == *" $n "* ]]; then
          (($# >= 2)) || die "$1 needs a value" 2
          v="o_${n//-/_}"; cur=${!v:-}
          printf -v "$v" '%s' "${cur:+$cur$'\n'}$2"; shift 2
        else die "unknown option $1 (ph help)" 2; fi ;;
      *) POS+=("$1"); shift ;;
    esac
  done
  if [[ -n "${o_limit:-}" ]]; then int_ok "$o_limit" "--limit"; fi
}
need() { (( ${#POS[@]} >= $1 )) || die "usage: ph $2" 2; }
variants_ok() { # a:50,b:50 with whole percentages adding up to 100
  [[ "$1" =~ ^[A-Za-z0-9_-]+:[0-9]{1,3}(,[A-Za-z0-9_-]+:[0-9]{1,3})+$ ]] || die "--variants is key:percent,key:percent (at least two)" 2
  jq -en --arg v "$1" '[$v | split(",")[] | split(":")[1] | tonumber] | add == 100' >/dev/null || die "--variants percentages must add up to 100" 2
}
id_ok() { [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "not a valid id or key: $1" 2; }
int_ok() { [[ "$1" =~ ^[0-9]+$ ]] || die "$2 must be a whole number" 2; }
pct_ok() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]+)?$ ]] && jq -en "$1 <= 100" >/dev/null || die "a rollout is a number from 0 to 100" 2; }
bool() { if [[ -n "${1:-}" ]]; then echo true; else echo false; fi; }

app() { printf '%s/project/%s/%s' "$host" "$project" "$1"; }

run_query() { # query-node-json -> the response; an error or an unfinished query stops, a truncated one says so
  local r
  r=$(raw POST "/api/projects/{project}/query/" "$(jq -cn --argjson q "$1" '{query: $q}')")
  if jq -e '(.error // "") != ""' >/dev/null <<<"$r"; then die "query failed: $(jq -r .error <<<"$r" | head -c 300)"; fi
  if jq -e '.query_status != null and .query_status.complete != true' >/dev/null <<<"$r"; then die "the query is still running in PostHog; run it again in a minute"; fi
  if jq -e '.hasMore == true' >/dev/null <<<"$r"; then note "partial: the query stopped at its row limit ($(jq -r '.limit // "default"' <<<"$r")); add a LIMIT or aggregate"; fi
  printf '%s\n' "$r"
}
hogql() { # SQL [values-json] -> a JSON array of row objects
  local vals=${2:-}
  [[ -n "$vals" ]] || vals='{}'
  run_query "$(jq -cn --arg q "$1" --argjson v "$vals" '{kind: "HogQLQuery", query: $q, values: $v}')" \
    | jq -c '[.columns as $c | .results[] | [$c, .] | transpose | map({(.[0]): .[1]}) | add]'
}

# ── Projects ──────────────────────────────────────────────────────────────────
all_projects() { # -> {projects: [...], skipped: <organizations this key could not list>}
  local me orgs oid oname out skipped=0 list=""
  me=$(raw GET "/api/users/@me/")
  orgs=$(jq -r '.organizations[] | "\(.id)\t\(.name)"' <<<"$me")
  while IFS=$'\t' read -r oid oname; do
    [[ -n "$oid" ]] || continue
    if [[ "$oid" =~ ^[A-Za-z0-9-]+$ ]] && out=$(raw GET "/api/organizations/$oid/projects/?limit=200" 2>/dev/null); then
      more "$out"
      list+=$(jq -c --arg o "$oname" '.results[] | {id, name, organization: $o}' <<<"$out")$'\n'
    else skipped=$((skipped + 1)); note "skipped organization $oname (this key cannot list its projects)"; fi
  done <<<"$orgs"
  printf '%s' "$list" | jq -s -c --argjson s "$skipped" '{projects: ., skipped: $s}'
}

need_project() {
  [[ -z "$project" ]] || return 0
  local all n
  all=$(all_projects); n=$(jq '.projects | length' <<<"$all")
  if [[ "$n" == 1 && $(jq .skipped <<<"$all") == 0 ]]; then
    project=$(jq -r '.projects[0].id' <<<"$all")
    note "using your only project $project; add  export POSTHOG_PROJECT_ID=$project  to your profile"
    return 0
  fi
  note "pick a project with  export POSTHOG_PROJECT_ID=<id>  (ph use <id>); this key reaches $n here$( [[ $(jq .skipped <<<"$all") == 0 ]] || echo ", and some organizations could not be listed"):"
  jq -c '.projects[]' <<<"$all" >&2
  exit 1
}

# ── Feature flags ─────────────────────────────────────────────────────────────
flag_find() { # key or id -> flag JSON, or nothing
  local f=$1
  id_ok "$f"
  if [[ "$f" =~ ^[0-9]+$ ]]; then raw GET "/api/projects/{project}/feature_flags/$f/"; return; fi
  raw GET "/api/projects/{project}/feature_flags/?key=$(q "$f")&limit=100" | jq -c --arg k "$f" '[.results[] | select(.key == $k)][0] // empty'
}
flag_get() { local out; out=$(flag_find "$1"); [[ -n "$out" ]] || die "no feature flag with key $1"; printf '%s\n' "$out"; }
# What an approval is bound to: the flag's configuration and version, not fields PostHog updates on its own.
FLAG_STATE='{id, key, active, deleted, version, filters}'
EXP_STATE='{id, name, start_date, end_date, archived, deleted, feature_flag_key, metrics, metrics_secondary}'
FLAG_SUMMARY='{id, key, name, active, rollout: [.filters.groups[]? | .rollout_percentage],
  conditions: [.filters.groups[]? | (.properties // []) | if length == 0 then "everyone" else map("\(.key) \(.operator // "exact") \(.value | tostring | clean)") | join(" and ") end],
  variants: ([.filters.multivariate.variants[]? | "\(.key):\(.rollout_percentage)"] | join(",")), version}'

cmd_flags() {
  local verb=${1:-list} f id body k p c r; shift || true
  case $verb in
    list)
      parse "active" "limit search" "$@"
      r=$(raw GET "/api/projects/{project}/feature_flags/?limit=${o_limit:-100}${o_search:+&search=$(q "$o_search")}${o_active:+&active=true}"); more "$r"
      jq -c "$CLEAN [.results[] | $FLAG_SUMMARY | del(.version)]" <<<"$r" | rows ;;
    get)
      parse "" "" "$@"; need 1 "flags get <key|id>"; f=$(flag_get "${POS[0]}")
      jq -c --arg u "$(app feature_flags/)" "$CLEAN $FLAG_SUMMARY + {filters: (.filters | walk(clean)), url: (\$u + (.id | tostring))}" <<<"$f" ;;
    evaluate)
      parse "" "" "$@"; need 2 "flags evaluate <flag> <distinct-id>"; f=$(flag_get "${POS[0]}"); id=$(jq -r .id <<<"$f")
      body=$(raw POST "/api/projects/{project}/feature_flags/$id/test_evaluation/" "$(jq -cn --arg d "${POS[1]}" '{distinct_id: $d}')")
      # The answer also carries the person's properties; they stay out unless --personal.
      jq -c --argjson e "$body" --argjson keep "$([[ -n "$PERSONAL" ]] && echo true || echo false)" "$CLEAN $FLAG_SUMMARY
        + {evaluation: (if \$keep then \$e else (\$e | {result, reason, reason_description, condition_index, payload}) end)}" <<<"$f" ;;
    create)
      parse "active" "name rollout prop variants" "$@"; need 1 "flags create <key> [options]"
      k=${POS[0]}; id_ok "$k"; p=${o_rollout:-0}; pct_ok "$p"
      if [[ -n "${o_variants:-}" ]]; then variants_ok "$o_variants"; fi
      body=$(jq -cn --arg k "$k" --arg n "${o_name:-$k}" --argjson r "$p" --argjson a "$(bool "${o_active:-}")" \
        --arg props "${o_prop:-}" --arg vars "${o_variants:-}" '
        def prop: if test("~") then capture("^(?<k>[^~]+)~(?<v>.*)$") | {key: .k, value: .v, operator: "icontains", type: "person"}
                  else capture("^(?<k>[^=]+)=(?<v>.*)$") | {key: .k, value: [.v], operator: "exact", type: "person"} end;
        {key: $k, name: $n, active: $a,
         filters: ({groups: [{properties: [$props | split("\n")[] | select(length > 0) | prop], rollout_percentage: $r}]}
           + (if $vars == "" then {} else {multivariate: {variants: [$vars | split(",")[] | split(":") | {key: .[0], rollout_percentage: (.[1] | tonumber)}]}} end))}')
      write POST "/api/projects/{project}/feature_flags/" "$body" \
        "Creates flag $k, active=$(bool "${o_active:-}"), served to $p% of matching users. An active flag reaches real users at once." ;;
    rollout)
      parse "" "condition" "$@"; need 2 "flags rollout <flag> <percent> [--condition N]"
      p=${POS[1]}; pct_ok "$p"; c=${o_condition:-0}; int_ok "$c" "--condition"
      f=$(flag_get "${POS[0]}"); id=$(jq -r .id <<<"$f")
      jq -e --argjson c "$c" '.filters.groups[$c] != null' >/dev/null <<<"$f" || die "flag $(jq -r .key <<<"$f") has no condition $c" 2
      body=$(jq -c --argjson c "$c" --argjson p "$p" '{condition_index: $c, rollout_percentage: $p, version}' <<<"$f")
      write POST "/api/projects/{project}/feature_flags/$id/set_release_condition_rollout/" "$body" \
        "Flag $(jq -r .key <<<"$f") (active=$(jq .active <<<"$f")): condition $c ($(jq -r --argjson c "$c" "$CLEAN"' .filters.groups[$c] | (.properties // []) | if length == 0 then "everyone" else map("\(.key) \(.operator // "exact") \(.value | tostring | clean)") | join(" and ") end' <<<"$f")) rollout $(jq --argjson c "$c" '.filters.groups[$c].rollout_percentage' <<<"$f")% -> $p%. If active, real users see it at once." \
        "$(jq -c "$FLAG_STATE" <<<"$f")" ;;
    enable|disable)
      parse "" "" "$@"; need 1 "flags $verb <flag>"; f=$(flag_get "${POS[0]}"); id=$(jq -r .id <<<"$f")
      write POST "/api/projects/{project}/feature_flags/$id/$verb/" "$(jq -c '{version}' <<<"$f")" \
        "Flag $(jq -r .key <<<"$f"): active $(jq .active <<<"$f") -> $([[ $verb == enable ]] && echo true || echo false), rollout $(jq -c '[.filters.groups[]?.rollout_percentage]' <<<"$f")% of matching users. Real users see the change at once." \
        "$(jq -c "$FLAG_STATE" <<<"$f")" ;;
    delete)
      parse "" "" "$@"; need 1 "flags delete <flag>"; f=$(flag_get "${POS[0]}"); id=$(jq -r .id <<<"$f")
      write PATCH "/api/projects/{project}/feature_flags/$id/" '{"deleted":true}' \
        "Deletes flag $(jq -r .key <<<"$f") (soft delete; active=$(jq .active <<<"$f")). Code still asking for it gets false." \
        "$(jq -c "$FLAG_STATE" <<<"$f")" ;;
    *) die "unknown: flags $verb (ph help)" 2 ;;
  esac
}

# ── Experiments ───────────────────────────────────────────────────────────────
EXP_SUMMARY='{id, name, status, flag: .feature_flag_key, start_date, end_date, archived,
  variants: ([.feature_flag.filters.multivariate.variants[]? // .parameters.feature_flag_variants[]? | "\(.key):\(.rollout_percentage)"] | join(",")),
  metrics: [(.metrics // [])[] | .name // (.source.event // ([.series[]?.event] | join(" > ")))]}'
METRIC_NAME='(.name // .source.event // ([.series[]?.event] | join(" > ")))'

exp_get() { int_ok "$1" "experiment id"; raw GET "/api/projects/{project}/experiments/$1/"; }

# One row per metric and variant. The estimate follows the metric type: a ratio is sum / denominator_sum,
# a funnel a conversion rate, a mean the value per exposure. PostHog's validation failures are kept, never dropped.
RESULT_ROW='([.baseline] + (.variant_results // []))[] | select(. != null)
  | (.denominator_sum != null) as $ratio
  | {metric: ($it.m | METRIC), type: ($it.m.metric_type // (if $ratio then "ratio" else "mean" end)), primary: $it.primary,
     variant: .key, method, exposures: .number_of_samples,
     numerator: .sum, denominator: (if $ratio then .denominator_sum else .number_of_samples end),
     estimate: (if $ratio then (if .denominator_sum != 0 then .sum / .denominator_sum else null end)
                elif (.number_of_samples // 0) > 0 then .sum / .number_of_samples else null end | if . == null then . else (. * 10000 | round / 10000) end),
     estimate_is: (if $ratio then "ratio" elif $it.m.metric_type == "funnel" then "conversion rate" else "mean per exposure" end),
     chance_to_win, p_value, significant, interval: (.credible_interval // .confidence_interval),
     validation_failures: (.validation_failures // [])}'

cmd_experiments() {
  local verb=${1:-list} e id body name v r flag state; shift || true
  case $verb in
    list)
      parse "" "status limit search" "$@"
      r=$(raw GET "/api/projects/{project}/experiments/?limit=${o_limit:-100}${o_status:+&status=$(q "$o_status")}${o_search:+&search=$(q "$o_search")}"); more "$r"
      jq -c "[.results[] | $EXP_SUMMARY | del(.metrics)]" <<<"$r" | rows ;;
    get)
      parse "" "" "$@"; need 1 "experiments get <id>"; id=${POS[0]}; e=$(exp_get "$id")
      jq -c --arg u "$(app experiments/)$id" "$EXP_SUMMARY + {description, conclusion, url: \$u}" <<<"$e" ;;
    results)
      parse "" "" "$@"; need 1 "experiments results <id>"; id=${POS[0]}; e=$(exp_get "$id")
      [[ $(jq '(.metrics // []) + (.metrics_secondary // []) | length' <<<"$e") -gt 0 ]] || die "experiment $id has no metrics in the current format; open it in the app"
      jq -c '[(.metrics // [])[] | {m: ., primary: true}] + [(.metrics_secondary // [])[] | {m: ., primary: false}] | .[]' <<<"$e" | while read -r item; do
        run_query "$(jq -c --argjson id "$id" '{kind: "ExperimentQuery", experiment_id: $id, metric: .m}' <<<"$item")" \
          | jq -c --argjson it "$item" "${RESULT_ROW//METRIC/$METRIC_NAME}"
      done | jq -s . | rows ;;
    create)
      parse "allow-unknown-events" "flag variants event funnel description" "$@"; need 1 "experiments create <name> --flag <key> [options]"
      name=${POS[0]}; [[ -n "${o_flag:-}" ]] || die "--flag <key> is required" 2; id_ok "$o_flag"
      [[ -z "${o_event:-}" || -z "${o_funnel:-}" ]] || die "give --event or --funnel, not both" 2
      flag=$(flag_find "$o_flag")
      if [[ -n "$flag" ]]; then
        # PostHog links an existing flag as it is and rejects flag settings on create, so none are sent.
        [[ -z "${o_variants:-}" ]] || die "flag $o_flag exists, and its own variants are used; change them on the flag (ph flags ...), not here" 2
        jq -e '[.filters.multivariate.variants[]?.key] | index("control") != null' >/dev/null <<<"$flag" \
          || die "flag $o_flag exists but has no multivariate variant named control; an experiment needs one" 2
        v=$(jq -r '[.filters.multivariate.variants[] | "\(.key):\(.rollout_percentage)"] | join(",")' <<<"$flag")
        state=$(jq -c "$FLAG_STATE" <<<"$flag")
      else
        v=${o_variants:-control:50,test:50}; variants_ok "$v"; state=""
      fi
      body=$(jq -cn --arg n "$name" --arg k "$o_flag" --arg v "$v" --arg ev "${o_event:-}" --arg fu "${o_funnel:-}" --arg d "${o_description:-}" \
        --argjson u "$(bool "${o_allow_unknown_events:-}")" --argjson reuse "$([[ -n "$flag" ]] && echo true || echo false)" '
        {name: $n, feature_flag_key: $k, type: "product", description: $d,
         metrics: (if $ev != "" then [{kind: "ExperimentMetric", metric_type: "mean", name: $ev, source: {kind: "EventsNode", event: $ev}}]
                   elif $fu != "" then [{kind: "ExperimentMetric", metric_type: "funnel", name: ($fu | split(",") | join(" > ")), series: [$fu | split(",")[] | {kind: "EventsNode", event: .}]}]
                   else [] end)}
        + (if $reuse then {} else {feature_flag: {filters: {multivariate: {variants: [$v | split(",")[] | split(":") | {key: .[0], rollout_percentage: (.[1] | tonumber)}]}}}} end)
        + (if $u then {allow_unknown_events: true} else {} end)')
      if [[ -n "$flag" ]]; then
        write POST "/api/projects/{project}/experiments/" "$body" \
          "Creates draft experiment \"$name\" on the EXISTING flag $o_flag (active=$(jq .active <<<"$flag"), variants $v, rollout $(jq -c '[.filters.groups[]?.rollout_percentage]' <<<"$flag")%), used as it is. An active flag already serves real users; the experiment counts them from launch." "$state"
      else
        write POST "/api/projects/{project}/experiments/" "$body" \
          "Creates draft experiment \"$name\" with a NEW flag $o_flag, variants $v. Nobody is enrolled until launch."
      fi ;;
    launch)
      parse "" "" "$@"; need 1 "experiments launch <id>"; id=${POS[0]}; e=$(exp_get "$id")
      write POST "/api/projects/{project}/experiments/$id/launch/" "" \
        "Launches \"$(jq -r .name <<<"$e")\" (now $(jq -r .status <<<"$e")): activates flag $(jq -r .feature_flag_key <<<"$e") and sets start_date to now. Real users start getting variants." \
        "$(jq -c "$EXP_STATE" <<<"$e")" ;;
    stop)
      parse "" "conclusion comment" "$@"; need 1 "experiments stop <id>"; id=${POS[0]}; e=$(exp_get "$id")
      if [[ -n "${o_conclusion:-}" ]]; then [[ "$o_conclusion" =~ ^(won|lost|inconclusive|stopped_early|invalid)$ ]] || die "--conclusion is won, lost, inconclusive, stopped_early or invalid" 2; fi
      body=$(jq -cn --arg c "${o_conclusion:-}" --arg m "${o_comment:-}" '{} + (if $c != "" then {conclusion: $c} else {} end) + (if $m != "" then {conclusion_comment: $m} else {} end)')
      write POST "/api/projects/{project}/experiments/$id/end/" "$body" \
        "Ends \"$(jq -r .name <<<"$e")\": end_date = now, results freeze. The flag is NOT changed; users keep their variants until flag $(jq -r .feature_flag_key <<<"$e") changes." \
        "$(jq -c "$EXP_STATE" <<<"$e")" ;;
    archive)
      parse "disable-flag" "" "$@"; need 1 "experiments archive <id> [--disable-flag]"; id=${POS[0]}; e=$(exp_get "$id")
      write POST "/api/projects/{project}/experiments/$id/archive/" "{\"disable_feature_flag\":$(bool "${o_disable_flag:-}")}" \
        "Archives \"$(jq -r .name <<<"$e")\" (it must be ended)$([[ -n "${o_disable_flag:-}" ]] && echo ", and disables flag $(jq -r .feature_flag_key <<<"$e")")." \
        "$(jq -c "$EXP_STATE" <<<"$e")" ;;
    delete)
      parse "" "" "$@"; need 1 "experiments delete <id>"; id=${POS[0]}; e=$(exp_get "$id")
      write PATCH "/api/projects/{project}/experiments/$id/" '{"deleted":true}' \
        "Deletes experiment \"$(jq -r .name <<<"$e")\" (soft delete). Flag $(jq -r .feature_flag_key <<<"$e") stays; remove it with ph flags delete." \
        "$(jq -c "$EXP_STATE" <<<"$e")" ;;
    *) die "unknown: experiments $verb (ph help)" 2 ;;
  esac
}

# ── Queries behind the reports and insights ───────────────────────────────────
range_json() { # -> dateRange: --from/--to dates, else the last --days days
  if [[ -n "${o_from:-}" ]]; then
    jq -cn --arg f "$o_from" --arg t "${o_to:-}" '{date_from: $f} + (if $t != "" then {date_to: $t} else {} end)'
  else jq -cn --arg d "-${days}d" '{date_from: $d}'; fi
}
trend_q() { # event interval breakdown math
  jq -cn --arg e "$1" --argjson r "$(range_json)" --arg i "$2" --arg b "$3" --arg m "$4" '
    {kind: "TrendsQuery", series: [{kind: "EventsNode", event: $e, name: $e, math: $m}], dateRange: $r, interval: $i}
    + (if $b != "" then {breakdownFilter: {breakdown: $b, breakdown_type: "event"}} else {} end)'
}
funnel_q() { # window breakdown events...
  local w=$1 b=$2; shift 2
  jq -cn --argjson r "$(range_json)" --argjson w "$w" --arg b "$b" '{kind: "FunnelsQuery", series: [$ARGS.positional[] | {kind: "EventsNode", event: ., name: .}],
    dateRange: $r, funnelsFilter: {funnelWindowInterval: $w, funnelWindowIntervalUnit: "day"}}
    + (if $b != "" then {breakdownFilter: {breakdown: $b, breakdown_type: "event"}} else {} end)' --args "$@"
}
retention_q() { # event return-event period intervals
  jq -cn --arg e "$1" --arg r "$2" --arg p "$3" --argjson n "$4" '
    {kind: "RetentionQuery", dateRange: {date_from: "-\($n)\($p[0:1] | ascii_downcase)"},
     retentionFilter: {period: $p, totalIntervals: $n, targetEntity: {id: $e, type: "events"}, returningEntity: {id: $r, type: "events"}}}'
}
REPORT_VALS="days from to interval breakdown math window period intervals return-event"
report_opts() { # after parse: defaults, validated
  days=${o_days:-30}; int_ok "$days" "--days"
  local d
  for d in "${o_from:-}" "${o_to:-}"; do
    [[ -z "$d" || "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "--from and --to are dates, YYYY-MM-DD" 2
  done
  [[ -z "${o_to:-}" || -n "${o_from:-}" ]] || die "--to needs --from" 2
  interval=${o_interval:-day}; [[ "$interval" =~ ^(hour|day|week|month)$ ]] || die "--interval is hour, day, week or month" 2
  math=${o_math:-total}; [[ "$math" =~ ^(total|dau|weekly_active|monthly_active)$ ]] || die "--math is total, dau, weekly_active or monthly_active" 2
  window=${o_window:-14}; int_ok "$window" "--window"
  period=${o_period:-Week}; [[ "$period" =~ ^(Day|Week|Month)$ ]] || die "--period is Day, Week or Month" 2
  intervals=${o_intervals:-8}; int_ok "$intervals" "--intervals"
}

cmd_trend() {
  parse "" "$REPORT_VALS" "$@"; report_opts; need 1 "trend <event> [options]"
  run_query "$(trend_q "${POS[0]}" "$interval" "${o_breakdown:-}" "$math")" \
    | jq -c '[.results[] | . as $s | range(0; ($s.days // []) | length) | {series: ($s.breakdown_value // $s.label | if type == "string" then . else tojson end | gsub("\\$\\$_posthog_breakdown_null_\\$\\$"; "(none)")), date: $s.days[.], value: $s.data[.]}]' | rows
}
cmd_funnel() {
  parse "" "$REPORT_VALS" "$@"; report_opts; need 2 "funnel <event1> <event2>... [options]"
  # Unique people, steps in order, each within --window days of the first step.
  run_query "$(funnel_q "$window" "${o_breakdown:-}" "${POS[@]}")" \
    | jq -c '.results | (if (.[0] | type) == "array" then . else [.] end)
        | [.[] | . as $s | $s[] | {breakdown: (.breakdown_value // null | if type == "array" then join(",") else . end), step: (.order + 1), event: .name, count,
           of_first: (if $s[0].count > 0 then (.count / $s[0].count * 1000 | round / 1000) else null end), median_seconds: .median_conversion_time}]
        | if all(.breakdown == null) then map(del(.breakdown)) else . end' | rows
}
cmd_retention() {
  parse "" "$REPORT_VALS" "$@"; report_opts; need 1 "retention <event> [options]"
  run_query "$(retention_q "${POS[0]}" "${o_return_event:-${POS[0]}}" "$period" "$intervals")" \
    | jq -c '[.results[] | {cohort: .date, size: .values[0].count, retained: [.values[] | .count]}]' | rows
}

# ── Dashboards and insights ───────────────────────────────────────────────────
insight_get() { # id or short id [refresh]
  local i=$1 refresh=${2:-}; id_ok "$i"
  if [[ "$i" =~ ^[0-9]+$ ]]; then raw GET "/api/projects/{project}/insights/$i/${refresh:+?refresh=blocking}"
  else raw GET "/api/projects/{project}/insights/?short_id=$(q "$i")${refresh:+&refresh=blocking}" | jq -c '.results[0] // empty'; fi
}

cmd_dashboards() {
  local verb=${1:-list} id d; shift || true
  case $verb in
    list)
      parse "" "limit search" "$@"
      list_get "/api/projects/{project}/dashboards/?limit=${o_limit:-100}${o_search:+&search=$(q "$o_search")}" \
        | jq -c '[.results[] | {id, name, pinned, tags, last_viewed_at}]' | rows ;;
    get)
      parse "" "" "$@"; need 1 "dashboards get <id>"; id=${POS[0]}; int_ok "$id" "dashboard id"
      d=$(raw GET "/api/projects/{project}/dashboards/$id/")
      jq -c --arg u "$(app dashboard/)$id" '{id, name, description, url: $u,
        tiles: [.tiles[] | select(.deleted != true) | if .insight then {tile: .id, insight: .insight.id, short_id: .insight.short_id, name: (.insight.name // .insight.derived_name), kind: .insight.query.source.kind}
                                                      else {tile: .id, text: (.text.body // "" | .[0:120])} end]}' <<<"$d" ;;
    url) parse "" "" "$@"; need 1 "dashboards url <id>"; int_ok "${POS[0]}" "dashboard id"; echo "$(app dashboard/)${POS[0]}" ;;
    create)
      parse "" "description" "$@"; need 1 "dashboards create <name>"
      write POST "/api/projects/{project}/dashboards/" "$(jq -cn --arg n "${POS[0]}" --arg x "${o_description:-}" '{name: $n, description: $x}')" "Creates dashboard \"${POS[0]}\"." ;;
    add)
      parse "" "" "$@"; need 2 "dashboards add <dashboard-id> <insight-id>"; int_ok "${POS[0]}" "dashboard id"; int_ok "${POS[1]}" "insight id"
      write POST "/api/projects/{project}/dashboards/${POS[0]}/add_insight/" "{\"insight_id\":${POS[1]}}" "Adds insight ${POS[1]} as a tile on dashboard ${POS[0]}." ;;
    delete)
      parse "" "" "$@"; need 1 "dashboards delete <id>"; id=${POS[0]}; int_ok "$id" "dashboard id"
      d=$(raw GET "/api/projects/{project}/dashboards/$id/")
      write PATCH "/api/projects/{project}/dashboards/$id/" '{"deleted":true}' "Deletes dashboard \"$(jq -r .name <<<"$d")\" (soft delete; its insights stay)." "$(jq -c '{id, name, deleted}' <<<"$d")" ;;
    *) die "unknown: dashboards $verb (ph help)" 2 ;;
  esac
}

cmd_insights() {
  local verb=${1:-list} i body src kind; shift || true
  case $verb in
    list)
      parse "" "limit search" "$@"
      list_get "/api/projects/{project}/insights/?limit=${o_limit:-100}${o_search:+&search=$(q "$o_search")}" \
        | jq -c '[.results[] | {id, short_id, name: (.name // .derived_name), kind: (.query.source.kind // .query.kind), last_modified_at}]' | rows ;;
    get)
      parse "" "" "$@"; need 1 "insights get <id|short-id>"; i=$(insight_get "${POS[0]}" refresh); [[ -n "$i" ]] || die "no insight ${POS[0]}"
      jq -c --arg u "$(app insights/)" '{id, short_id, name: (.name // .derived_name), kind: (.query.source.kind // .query.kind), url: ($u + .short_id), last_refresh, query: (.query.source // .query), result}' <<<"$i" ;;
    url)
      parse "" "" "$@"; need 1 "insights url <id|short-id>"; i=$(insight_get "${POS[0]}"); [[ -n "$i" ]] || die "no insight ${POS[0]}"
      echo "$(app insights/)$(jq -r .short_id <<<"$i")" ;;
    create)
      kind=${1:-}; shift || true
      parse "" "name dashboard $REPORT_VALS" "$@"; report_opts
      [[ -n "${o_name:-}" ]] || die "--name is required" 2
      case $kind in
        trend) need 1 "insights create trend <event> --name N"
               src=$(jq -cn --argjson s "$(trend_q "${POS[0]}" "$interval" "${o_breakdown:-}" "$math")" '{kind: "InsightVizNode", source: $s}') ;;
        funnel) need 2 "insights create funnel <e1> <e2>... --name N"
                src=$(jq -cn --argjson s "$(funnel_q "$window" "${o_breakdown:-}" "${POS[@]}")" '{kind: "InsightVizNode", source: $s}') ;;
        hogql) need 1 "insights create hogql 'SQL' --name N"
               src=$(jq -cn --arg q "${POS[0]}" '{kind: "DataVisualizationNode", source: {kind: "HogQLQuery", query: $q}}') ;;
        *) die "usage: ph insights create trend|funnel|hogql ... --name N" 2 ;;
      esac
      if [[ -n "${o_dashboard:-}" ]]; then int_ok "$o_dashboard" "--dashboard"; fi
      body=$(jq -cn --arg n "$o_name" --argjson q "$src" --arg d "${o_dashboard:-}" '{name: $n, query: $q} + (if $d != "" then {dashboards: [$d | tonumber]} else {} end)')
      write POST "/api/projects/{project}/insights/" "$body" "Creates $kind insight \"$o_name\"${o_dashboard:+ on dashboard $o_dashboard}." ;;
    delete)
      parse "" "" "$@"; need 1 "insights delete <id>"; int_ok "${POS[0]}" "insight id"
      i=$(insight_get "${POS[0]}")
      write PATCH "/api/projects/{project}/insights/${POS[0]}/" '{"deleted":true}' "Deletes insight \"$(jq -r '.name // .derived_name' <<<"$i")\" (soft delete; it leaves every dashboard)." "$(jq -c '{id, name, deleted}' <<<"$i")" ;;
    *) die "unknown: insights $verb (ph help)" 2 ;;
  esac
}

# ── Events, properties, actions ───────────────────────────────────────────────
cmd_events() {
  local verb=${1:-top} d p; shift || true
  case $verb in
    top)
      parse "" "days limit" "$@"; int_ok "${o_days:-7}" "--days"; int_ok "${o_limit:-50}" "--limit"
      hogql "SELECT event, count() AS count, uniq(distinct_id) AS users, max(timestamp) AS last_seen FROM events
             WHERE timestamp > now() - INTERVAL ${o_days:-7} DAY GROUP BY event ORDER BY count DESC LIMIT ${o_limit:-50}" | rows ;;
    list)
      parse "" "search limit" "$@"
      list_get "/api/projects/{project}/event_definitions/?limit=${o_limit:-100}${o_search:+&search=$(q "$o_search")}" \
        | jq -c '[.results[] | {id, name, last_seen_at, verified, tags, description}]' | rows ;;
    describe)
      parse "" "" "$@"; need 1 "events describe <name>"
      d=$(raw GET "/api/projects/{project}/event_definitions/by_name/?name=$(q "${POS[0]}")")
      p=$(raw GET "/api/projects/{project}/property_definitions/?type=event&filter_by_event_names=true&limit=200&event_names=$(q "$(jq -cn --arg n "${POS[0]}" '[$n]')")")
      jq -c --argjson p "$p" '{id, name, description, verified, tags, last_seen_at, properties: [$p.results[] | {name, property_type}]}' <<<"$d" ;;
    verify)
      parse "" "" "$@"; need 1 "events verify <name>"
      d=$(raw GET "/api/projects/{project}/event_definitions/by_name/?name=$(q "${POS[0]}")")
      write PATCH "/api/projects/{project}/event_definitions/$(jq -r .id <<<"$d")/" '{"verified":true}' \
        "Marks event $(jq -r .name <<<"$d") verified (now $(jq .verified <<<"$d"); a paid-plan feature)." "$(jq -c '{id, name, verified}' <<<"$d")" ;;
    *) die "unknown: events $verb (ph help)" 2 ;;
  esac
}

cmd_properties() {
  [[ "${1:-list}" == list ]] || die "usage: ph properties list [--event NAME] [--search S]" 2; shift || true
  parse "" "event search limit" "$@"
  local qs="limit=${o_limit:-200}&type=event${o_search:+&search=$(q "$o_search")}"
  if [[ -n "${o_event:-}" ]]; then qs+="&filter_by_event_names=true&event_names=$(q "$(jq -cn --arg n "$o_event" '[$n]')")"; fi
  list_get "/api/projects/{project}/property_definitions/?$qs" | jq -c '[.results[] | {name, property_type, is_numerical, verified}]' | rows
}

cmd_actions() {
  [[ "${1:-list}" == list ]] || die "usage: ph actions list" 2; shift || true
  parse "" "limit" "$@"
  list_get "/api/projects/{project}/actions/?limit=${o_limit:-100}" | jq -c '[.results[] | {id, name, description, steps: (.steps | length), last_calculated_at}]' | rows
}

# ── Recordings ────────────────────────────────────────────────────────────────
person_find() { # distinct id or email -> person JSON, or nothing
  local p
  p=$(raw GET "/api/projects/{project}/persons/?distinct_id=$(q "$1")" | jq -c '.results[0] // empty')
  if [[ -z "$p" && "$1" == *@* ]]; then p=$(raw GET "/api/projects/{project}/persons/?email=$(q "$1")" | jq -c '.results[0] // empty'); fi
  printf '%s' "$p"
}
sid_ok() { [[ "$1" =~ ^[A-Za-z0-9-]+$ ]] || die "not a session id: $1" 2; }

# Recording exports hold what people typed and saw: refuse any folder inside a git repository (found without
# needing git, so a missing git cannot let it through) and any folder other users can write to.
in_repo() { local d=$1; while :; do [[ -e "$d/.git" ]] && return 0; [[ "$d" == / ]] && return 1; d=$(dirname "$d"); done; }

cmd_recordings() {
  local verb=${1:-list} s p preds qs file dir src n start end r perms; shift || true
  case $verb in
    list)
      parse "errors" "days person min-duration url limit" "$@"
      int_ok "${o_days:-1}" "--days"; int_ok "${o_limit:-20}" "--limit"
      if [[ -n "${o_min_duration:-}" ]]; then int_ok "$o_min_duration" "--min-duration"; fi
      preds=$(jq -cn --arg d "${o_min_duration:-}" --arg e "${o_errors:-}" --arg u "${o_url:-}" '
        [ (if $d != "" then {key: "duration", type: "recording", operator: "gt", value: ($d | tonumber)} else empty end),
          (if $e != "" then {key: "console_error_count", type: "recording", operator: "gt", value: 0} else empty end),
          (if $u != "" then {key: "first_url", type: "recording", operator: "icontains", value: $u} else empty end) ]')
      qs="date_from=-${o_days:-1}d&limit=${o_limit:-20}&order=start_time&order_direction=DESC&having_predicates=$(q "$preds")"
      if [[ -n "${o_person:-}" ]]; then
        p=$(person_find "$o_person"); [[ -n "$p" ]] || die "no person with that distinct id or email"
        qs+="&person_uuid=$(q "$(jq -r .uuid <<<"$p")")"
      fi
      list_get "/api/projects/{project}/session_recordings/?$qs" | jq -c --arg u "$(app replay/)" "$CLEAN"'[.results[] | {id, start_time, duration: .recording_duration, active_seconds,
          clicks: .click_count, keys: .keypress_count, console_errors: .console_error_count, start_url: (.start_url | clean), distinct_id: (.distinct_id | '"$(pid)"'), url: ($u + .id)}
          | with_entries(select(.value != null))]' | rows ;;
    get)
      parse "" "" "$@"; need 1 "recordings get <session-id>"; s=${POS[0]}; sid_ok "$s"
      raw GET "/api/projects/{project}/session_recordings/$s/" | jq -c --arg u "$(app replay/)$s" "$CLEAN"'{id, start_time, end_time, duration: .recording_duration, active_seconds, inactive_seconds,
          clicks: .click_count, keys: .keypress_count, mouse: .mouse_activity_count, console_logs: .console_log_count, console_warnings: .console_warn_count,
          console_errors: .console_error_count, start_url: (.start_url | clean), distinct_id: (.distinct_id | '"$(pid)"'), person_uuid: .person.uuid, event_count, ongoing, viewed, url: $u}
          | with_entries(select(.value != null))' ;;
    console)
      parse "" "level limit" "$@"; need 1 "recordings console <session-id>"; s=${POS[0]}; sid_ok "$s"; int_ok "${o_limit:-100}" "--limit"
      if [[ -n "${o_level:-}" ]]; then [[ "$o_level" =~ ^(error|warn|info|log)$ ]] || die "--level is error, warn, info or log" 2; fi
      r=$(raw GET "/api/projects/{project}/session_recordings/$s/console_logs/?limit=${o_limit:-100}${o_level:+&level=$o_level}")
      # Empty can mean "not captured" or "expired", not "no errors": say which.
      if jq -e '.console_log_capture_enabled == false' >/dev/null <<<"$r"; then note "console log capture is off for this project: an empty list means nothing was captured"; fi
      if jq -e '.logs_expired == true' >/dev/null <<<"$r"; then note "this recording's console logs have expired"; fi
      more "$r"
      jq -c "$CLEAN"' [(.results // [])[] | {timestamp, level, message: (.message | clean), truncated}]' <<<"$r" | rows ;;
    events)
      parse "" "limit" "$@"; need 1 "recordings events <session-id>"; s=${POS[0]}; sid_ok "$s"; int_ok "${o_limit:-500}" "--limit"
      hogql "SELECT timestamp, event, properties.\$current_url AS url, properties.\$event_type AS dom_event,
                    properties.\$exception_types AS exception_types, properties.\$exception_values AS exception_values
             FROM events WHERE \$session_id = {sid} AND timestamp > now() - INTERVAL 90 DAY ORDER BY timestamp LIMIT ${o_limit:-500}" \
        "$(jq -cn --arg s "$s" '{sid: $s}')" | jq -c "$CLEAN"' map(.url |= clean | .exception_values |= (if type == "array" then map(clean) else clean end))' | rows ;;
    export)
      parse "" "" "$@"; need 2 "recordings export <session-id> <file>"; s=${POS[0]}; sid_ok "$s"; file=${POS[1]}
      dir=$(cd "$(dirname "$file")" 2>/dev/null && pwd -P) || die "the folder of $file does not exist"
      file="$dir/$(basename "$file")"
      [[ ! -e "$file" && ! -L "$file" ]] || die "$file exists; give a new file name"
      ! in_repo "$dir" || die "$dir is inside a git repository; a recording holds personal data, so write it outside any repo"
      perms=$(ls -ld "$dir" | cut -c6,9)
      [[ -O "$dir" && "$perms" != *w* ]] || die "$dir is not yours alone (owner or group/other write); pick a private folder such as ~/Downloads"
      src=$(raw GET "/api/projects/{project}/session_recordings/$s/snapshots/")
      n=$(jq '.sources | length' <<<"$src"); ((n > 0)) || die "recording $s has no snapshot data"
      # Created once, exclusively (noclobber is O_EXCL: it fails on any existing name, a symlink included), readable by the user only.
      (umask 077 && set -C && : >"$file") 2>/dev/null || die "could not create $file as a new file"
      trap 'rm -f "$file"; note "export failed; the partial file was removed"' EXIT
      # A personal API key may fetch at most 21 blocks per call (end_blob_key - start_blob_key <= 20).
      # shortcut: each call's blocks pass through a shell variable; fine for normal sessions, slow for multi-hour ones.
      for ((start = 0; start < n; start += 21)); do
        end=$((start + 20 < n - 1 ? start + 20 : n - 1))
        raw GET "/api/projects/{project}/session_recordings/$s/snapshots/?source=blob_v2&start_blob_key=$start&end_blob_key=$end" >>"$file"
      done
      trap - EXIT
      jq -cn --arg f "$file" --argjson n "$n" --argjson l "$(wc -l <"$file" | tr -d ' ')" '{file: $f, blocks: $n, lines: $l, format: "JSON lines, each [window_id, rrweb event]"}' ;;
    *) die "unknown: recordings $verb (ph help)" 2 ;;
  esac
}

cmd_playlists() {
  local verb=${1:-list}; shift || true
  case $verb in
    list)
      parse "" "limit" "$@"
      list_get "/api/projects/{project}/session_recording_playlists/?limit=${o_limit:-100}" \
        | jq -c '[.results[] | {short_id, name: (.name // .derived_name), type, pinned}]' | rows ;;
    add)
      parse "" "" "$@"; need 2 "playlists add <playlist-short-id> <session-id>"; id_ok "${POS[0]}"; sid_ok "${POS[1]}"
      write POST "/api/projects/{project}/session_recording_playlists/${POS[0]}/recordings/${POS[1]}/" "" "Adds recording ${POS[1]} to playlist ${POS[0]}." ;;
    *) die "unknown: playlists $verb (ph help)" 2 ;;
  esac
}

# ── People and cohorts ────────────────────────────────────────────────────────
cmd_persons() {
  local verb=${1:-} p; shift || true
  [[ "$verb" =~ ^(find|events)$ ]] || die "usage: ph persons find|events <distinct-id|email>" 2
  parse "" "days limit" "$@"; need 1 "persons $verb <distinct-id|email>"
  p=$(person_find "${POS[0]}"); [[ -n "$p" ]] || die "no person with that distinct id or email"
  if [[ $verb == find ]]; then
    jq -c '{uuid, distinct_ids: .distinct_ids[0:5], distinct_id_count: (.distinct_ids | length), is_identified, created_at, last_seen_at}
      | if '"$([[ -n "$PERSONAL" ]] && echo true || echo false)"' then . else del(.distinct_ids) end' <<<"$p"
  else
    int_ok "${o_days:-30}" "--days"; int_ok "${o_limit:-100}" "--limit"
    hogql "SELECT timestamp, event, properties.\$current_url AS url, \$session_id AS session_id FROM events
           WHERE person_id = {pid} AND timestamp > now() - INTERVAL ${o_days:-30} DAY ORDER BY timestamp DESC LIMIT ${o_limit:-100}" \
      "$(jq -c '{pid: .uuid}' <<<"$p")" | jq -c "$CLEAN"' map(.url |= clean)' | rows
  fi
}

cmd_cohorts() {
  local verb=${1:-list} ids uuids; shift || true
  case $verb in
    list)
      parse "" "limit" "$@"
      list_get "/api/projects/{project}/cohorts/?limit=${o_limit:-100}" | jq -c '[.results[] | {id, name, count, is_static, created_at}]' | rows ;;
    create-static)
      parse "" "" "$@"; need 2 "cohorts create-static <name> <distinct-id>... | @file"
      if [[ "${POS[1]}" == @* ]]; then
        [[ -r "${POS[1]#@}" ]] || die "cannot read ${POS[1]#@}"
        ids=$(jq -R -s -c 'split("\n") | map(select(length > 0))' <"${POS[1]#@}")
      else ids=$(jq -cn '$ARGS.positional' --args "${POS[@]:1}"); fi
      uuids=$(hogql "SELECT DISTINCT person_id AS id FROM person_distinct_ids WHERE distinct_id IN {ids}" "$(jq -cn --argjson i "$ids" '{ids: $i}')" | jq -c '[.[].id]')
      [[ $(jq length <<<"$uuids") -gt 0 ]] || die "none of these distinct ids is a known person in this project"
      write POST "/api/projects/{project}/cohorts/" "$(jq -cn --arg n "${POS[0]}" --argjson u "$uuids" '{name: $n, is_static: true, _create_static_person_ids: $u}')" \
        "Creates static cohort \"${POS[0]}\" with $(jq length <<<"$uuids") persons found for $(jq length <<<"$ids") distinct ids." ;;
    *) die "unknown: cohorts $verb (ph help)" 2 ;;
  esac
}

# ── Annotations, surveys, error tracking ─────────────────────────────────────
cmd_annotations() {
  local verb=${1:-list} d; shift || true
  case $verb in
    list)
      parse "" "limit" "$@"
      list_get "/api/projects/{project}/annotations/?limit=${o_limit:-50}" | jq -c '[.results[] | {id, date_marker, content, scope}]' | rows ;;
    create)
      parse "" "date" "$@"; need 1 "annotations create <text> [--date ISO]"; d=${o_date:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}
      write POST "/api/projects/{project}/annotations/" "$(jq -cn --arg c "${POS[0]}" --arg d "$d" '{content: $c, date_marker: $d, scope: "project", creation_type: "USR"}')" \
        "Creates annotation \"${POS[0]}\" at $d on every chart in the project." ;;
    delete)
      parse "" "" "$@"; need 1 "annotations delete <id>"; int_ok "${POS[0]}" "annotation id"
      d=$(raw GET "/api/projects/{project}/annotations/${POS[0]}/")
      write PATCH "/api/projects/{project}/annotations/${POS[0]}/" '{"deleted":true}' "Deletes annotation ${POS[0]} \"$(jq -r .content <<<"$d")\"." "$(jq -c '{id, content, date_marker, deleted}' <<<"$d")" ;;
    *) die "unknown: annotations $verb (ph help)" 2 ;;
  esac
}

cmd_surveys() {
  local verb=${1:-list}; shift || true
  case $verb in
    list)
      parse "" "limit" "$@"
      list_get "/api/projects/{project}/surveys/?limit=${o_limit:-100}" | jq -c '[.results[] | {id, name, type, start_date, end_date, archived}]' | rows ;;
    get)
      parse "" "" "$@"; need 1 "surveys get <id>"; id_ok "${POS[0]}"
      raw GET "/api/projects/{project}/surveys/${POS[0]}/" | jq -c --arg u "$(app surveys/)${POS[0]}" '{id, name, type, start_date, end_date, archived,
        linked_flag: .linked_flag.key, questions: [.questions[]? | {type, question, choices}], url: $u}' ;;
    results)
      parse "" "days" "$@"; need 1 "surveys results <id>"; id_ok "${POS[0]}"; int_ok "${o_days:-30}" "--days"
      raw GET "/api/projects/{project}/surveys/${POS[0]}/stats/?include_per_question_stats=true&date_from=-${o_days:-30}d" | jq -c . ;;
    *) die "unknown: surveys $verb (ph help)" 2 ;;
  esac
}

cmd_errors() {
  [[ "${1:-list}" == list ]] || die "usage: ph errors list [--status S] [--limit N]" 2; shift || true
  parse "" "status limit" "$@"
  list_get "/api/projects/{project}/error_tracking/issues/?limit=${o_limit:-50}" \
    | jq -c --arg s "${o_status:-}" --arg u "$(app error_tracking/)" "$CLEAN"'[.results[] | select($s == "" or .status == $s)
        | {id, status, name: (.name | clean), description: (.description // "" | clean | .[0:160]), first_seen, url: ($u + .id)}]' | rows
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
cmd=${1:-}; shift || true
if [[ "${1:-}" == -- ]]; then shift; fi
case $cmd in
  whoami)
    me=$(raw GET /api/users/@me/); all=$(all_projects)
    jq -c --argjson a "$all" --arg h "$host" --arg d "$host_detected" --arg cur "$project" --argjson keep "$([[ -n "$PERSONAL" ]] && echo true || echo false)" \
      '(if $keep then {email} else {} end) + {host: $h, organizations: [.organizations[].name], projects: $a.projects,
        project: (if $cur == "" then null else $cur end)}
       + (if $a.skipped > 0 then {organizations_not_listed: $a.skipped} else {} end)
       + (if $d != "" then {export: "export POSTHOG_HOST=\($h)"} else {} end)' <<<"$me" ;;
  projects) all_projects | jq -c .projects | rows ;;
  use)
    p=${1:-}; int_ok "$p" "project id"
    raw GET "/api/projects/$p/" | jq -c '{id, name}' >&2
    echo "export POSTHOG_PROJECT_ID=$p" ;;
  GET|POST|PATCH|PUT|DELETE)
    [[ $# -ge 1 ]] || die "usage: ph METHOD /path [json-body|@file.json]" 2
    if [[ "$1" == *"{project}"* ]]; then need_project; fi
    body=${2:-}
    if [[ "$body" == @* ]]; then # the file's bytes are what the dry run shows and the approval code binds
      [[ -r "${body#@}" && ! -d "${body#@}" ]] || die "cannot read ${body#@}" 2
      body=$(jq -c . <"${body#@}") || die "${body#@} is not JSON" 2
    elif [[ -n "$body" ]]; then body=$(jq -c . <<<"$body") || die "the body is not JSON" 2; fi
    # Raw reads print the API's response as it is (keys redacted): personal data included, so use them deliberately.
    if [[ "$cmd" == GET || ( "$cmd" == POST && "$1" =~ /query/?(\?.*)?$ ) ]]; then raw "$cmd" "$1" "$body"
    else write "$cmd" "$1" "$body" "A raw $cmd call."; fi ;;
  flags|experiments|dashboards|insights|events|properties|actions|recordings|playlists|persons|cohorts|annotations|surveys|errors|trend|funnel|retention)
    need_project; "cmd_$cmd" "$@" ;;
  query)
    need_project; [[ $# -eq 1 ]] || die "usage: ph query 'HogQL'" 2
    hogql "$1" | rows ;;
  *) usage >&2; exit 2 ;;
esac
