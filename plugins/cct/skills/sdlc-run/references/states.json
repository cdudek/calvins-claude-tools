{
  "version": 1,
  "start": "gate-pass",
  "note": "What `sdlc_status.py goal` can say and how each state is left. tests (test_core_speed_b) keep it equal to the code and walk it: every blocked state names a command and reaches done.",
  "states": {
    "gate-pass": {
      "kind": "blocked",
      "actor": "agent",
      "command": "python3 scripts/verify_gate.py {scope} {id}",
      "to": [
        "no-pr:",
        "done"
      ]
    },
    "gate-sha-not-pr-": {
      "kind": "blocked",
      "actor": "agent",
      "command": "python3 scripts/verify_gate.py {scope} {id}",
      "to": [
        "gate-pass"
      ]
    },
    "no-pr:": {
      "kind": "blocked",
      "actor": "agent",
      "command": "gh pr create --head {n} --base {base} --fill",
      "to": [
        "pr-not-merged-or-armed"
      ]
    },
    "gh-unavailable": {
      "kind": "blocked",
      "actor": "owner",
      "command": "gh auth status",
      "to": [
        "no-pr:"
      ]
    },
    "findings-open": {
      "kind": "blocked",
      "actor": "agent",
      "command": "fix each open item in findings.md, tick it, commit",
      "to": [
        "gate-pass"
      ]
    },
    "findings-blocked": {
      "kind": "blocked",
      "actor": "owner",
      "command": "decide: a scope change with a new approval, or fix the named blocker",
      "to": [
        "gate-pass"
      ]
    },
    "validation-not-met": {
      "kind": "blocked",
      "actor": "agent",
      "command": "build the missing proof, then update validation.md",
      "to": [
        "gate-pass"
      ]
    },
    "not-converged": {
      "kind": "blocked",
      "actor": "agent",
      "command": "run the converge pass and add the Converged line",
      "to": [
        "gate-pass"
      ]
    },
    "project-gate-pass": {
      "kind": "blocked",
      "actor": "agent",
      "command": "python3 scripts/verify_gate.py project {id}",
      "to": [
        "no-pr:"
      ]
    },
    "gate-not-merged-into-": {
      "kind": "blocked",
      "actor": "agent",
      "command": "git switch <project branch> && git merge --no-ff <milestone branch>",
      "to": [
        "done"
      ]
    },
    "merge-missing:": {
      "kind": "blocked",
      "actor": "agent",
      "command": "on {n}: python3 scripts/verify_gate.py milestone {id} (writes its receipt); then git switch <project branch> && git merge --no-ff {n}",
      "to": [
        "done"
      ]
    },
    "receipt-not-merged:": {
      "kind": "blocked",
      "actor": "agent",
      "command": "on branch milestone/<slug>-{n}: python3 scripts/verify_gate.py milestone {id}, then merge it",
      "to": [
        "done"
      ]
    },
    "gate-sha-not-tip:": {
      "kind": "blocked",
      "actor": "agent",
      "command": "on {n}: python3 scripts/verify_gate.py milestone {id} (writes a new receipt)",
      "to": [
        "done"
      ]
    },
    "no-such-milestone:": {
      "kind": "blocked",
      "actor": "agent",
      "command": "grep -n '^| M' changes/{id}/plan.md, then ask for a listed number",
      "to": [
        "gate-pass"
      ]
    },
    "no-branch-for-": {
      "kind": "blocked",
      "actor": "owner",
      "command": "add the row to plan.md ## Feature PRs",
      "to": [
        "gate-pass"
      ]
    },
    "no-change-folder": {
      "kind": "blocked",
      "actor": "owner",
      "command": "python3 ${{CLAUDE_SKILL_DIR}}/scripts/sdlc_status.py map",
      "to": [
        "gate-pass"
      ]
    },
    "not-approved": {
      "kind": "blocked",
      "actor": "owner",
      "command": "python3 scripts/verify_gate.py approve {id}",
      "to": [
        "gate-pass"
      ]
    },
    "protected-path": {
      "kind": "blocked",
      "actor": "owner",
      "command": "decide whether the change stands; never re-lock without a decision",
      "to": [
        "gate-pass"
      ]
    },
    "no-progress": {
      "kind": "blocked",
      "actor": "owner",
      "command": "read verify/report.md, then delete verify/state.json to start over",
      "to": [
        "gate-pass"
      ]
    },
    "flaky": {
      "kind": "blocked",
      "actor": "owner",
      "command": "reproduce it locally three times and fix the check's flakiness in its own change",
      "to": [
        "gate-pass"
      ]
    },
    "unknown-verdict": {
      "kind": "blocked",
      "actor": "agent",
      "command": "read verify/report.md, then fix the check's output",
      "to": [
        "gate-pass"
      ]
    },
    "needs-comparison": {
      "kind": "blocked",
      "actor": "agent",
      "command": "compare the shots in verify/shots with the pinned design, write verify/comparison.json, then rerun `python3 scripts/verify_gate.py {scope} {id}`",
      "to": [
        "gate-pass"
      ]
    },
    "allowlist-request": {
      "kind": "blocked",
      "actor": "owner",
      "command": "decide whether to widen the allowlist; never widen it silently",
      "to": [
        "gate-pass"
      ]
    },
    "scope-growth": {
      "kind": "blocked",
      "actor": "owner",
      "command": "decide whether the plan or the edit moves",
      "to": [
        "gate-pass"
      ]
    },
    "spec-conflict": {
      "kind": "blocked",
      "actor": "owner",
      "command": "decide whether the spec or the build changes",
      "to": [
        "gate-pass"
      ]
    },
    "env": {
      "kind": "blocked",
      "actor": "owner",
      "command": "fix the environment named in the gate output, then rerun `python3 scripts/verify_gate.py {scope} {id}`",
      "to": [
        "gate-pass"
      ]
    },
    "test-proves-nothing": {
      "kind": "blocked",
      "actor": "agent",
      "command": "rewrite the test so it fails without the change",
      "to": [
        "gate-pass"
      ]
    },
    "attempts": {
      "kind": "blocked",
      "actor": "owner",
      "command": "read verify/report.md, then delete verify/state.json to start over",
      "to": [
        "gate-pass"
      ]
    },
    "pr-awaits-owner": {
      "kind": "blocked",
      "actor": "agent",
      "command": "AskUserQuestion Change <id>, finding PR<n>: Accept milestone | Hold",
      "to": [
        "pr-not-merged-or-armed",
        "pr-held"
      ]
    },
    "pr-held": {
      "kind": "blocked",
      "actor": "owner",
      "command": "gh pr edit <n> --remove-label hold, or answer Accept milestone",
      "to": [
        "pr-awaits-owner",
        "pr-not-merged-or-armed"
      ]
    },
    "pr-closed": {
      "kind": "blocked",
      "actor": "agent",
      "command": "gh pr create --base <parent> --fill",
      "to": [
        "pr-not-merged-or-armed"
      ]
    },
    "pr-awaits-tier": {
      "kind": "blocked",
      "actor": "agent",
      "command": "gh pr view <n> --json labels",
      "to": [
        "pr-not-merged-or-armed"
      ]
    },
    "pr-awaits-workflow": {
      "kind": "blocked",
      "actor": "agent",
      "command": "gh pr view <n> --json labels,autoMergeRequest",
      "to": [
        "pr-awaiting-ci"
      ]
    },
    "pr-wrong-base": {
      "kind": "blocked",
      "actor": "agent",
      "command": "gh pr edit <n> --base <parent>",
      "to": [
        "pr-not-merged-or-armed"
      ]
    },
    "pr-ci-failed": {
      "kind": "blocked",
      "actor": "agent",
      "command": "gh pr checks <n>",
      "to": [
        "pr-awaiting-ci"
      ]
    },
    "pr-label-awaiting-owner": {
      "kind": "blocked",
      "actor": "agent",
      "command": "gh pr edit <n> --remove-label awaiting-owner",
      "to": [
        "pr-not-merged-or-armed"
      ]
    },
    "pr-not-merged-or-armed": {
      "kind": "blocked",
      "actor": "agent",
      "command": "gh pr merge <n> --auto",
      "to": [
        "pr-awaiting-ci"
      ]
    },
    "pr-awaiting-ci": {
      "kind": "done",
      "actor": "github",
      "command": "nothing: auto-merge fires on green",
      "to": [
        "done"
      ]
    },
    "no-project-branch": {
      "kind": "blocked",
      "actor": "agent",
      "command": "python3 ${CLAUDE_SKILL_DIR}/scripts/sdlc_status.py record {id} project --sha <sha>",
      "to": [
        "project-not-accepted"
      ]
    },
    "project-not-integrated": {
      "kind": "blocked",
      "actor": "agent",
      "command": "merge every milestone into the default branch, then record the project again",
      "to": [
        "project-not-accepted"
      ]
    },
    "project-not-accepted": {
      "kind": "blocked",
      "actor": "owner",
      "command": "accept in the project dialog, then record the project with --accepted",
      "to": [
        "done"
      ]
    },
    "handoff": {
      "kind": "blocked",
      "actor": "owner",
      "command": "python3 ${CLAUDE_SKILL_DIR}/scripts/sdlc_status.py handoff {id} --resume",
      "to": [
        "gate-pass"
      ]
    },
    "done": {
      "kind": "terminal",
      "actor": "",
      "command": "",
      "to": []
    }
  }
}
